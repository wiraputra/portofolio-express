<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- SEO Meta Tags -->
    <title><%= data.info.nama %> — Portfolio</title>
    <meta name="description" content="<%= data.info.deskripsi %>">
    <meta name="keywords" content="Portfolio, Fullstack Developer, Frontend Developer, React, Laravel, Express, <%= data.info.nama %>">
    <meta name="author" content="<%= data.info.nama %>">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="Portfolio <%= data.info.nama %>">
    <meta property="og:description" content="<%= data.info.deskripsi %>">
    <meta property="og:image" content="<%= data.info.foto %>">

    <!-- Fonts: Poppins & Inter (Reference exact match) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@400;500;600;700;800;900&display=swap">
    
    <!-- Icons: Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Stylesheet -->
    <link rel="stylesheet" href="/style.css?v=50">
    <link rel="icon" href="/favicon.png" type="image/png">
</head>
<body>

    <!-- Interactive Three.js Background Canvas -->
    <canvas id="three-canvas" class="three-canvas" aria-hidden="true"></canvas>

    <!-- Ambient Subtle Gradient Backdrop -->
    <div class="ambient-gradient-backdrop" aria-hidden="true"></div>

    <!-- ====================================================================
         FLOATING NAVBAR (EXACT REFERENCE SPECIFICATION)
         ==================================================================== -->
    <header class="navbar-wrapper">
        <nav class="floating-navbar" aria-label="Main Navigation">
            <!-- Brand Logo -->
            <a href="#home" class="nav-logo" aria-label="Home">
                <span class="logo-initials">GW</span>
            </a>

            <!-- Nav Links (Desktop) -->
            <ul class="nav-menu" id="nav-menu">
                <li><a href="#home" class="nav-link active" data-section="home">Home</a></li>
                <li><a href="#skills" class="nav-link" data-section="skills">Skills</a></li>
                <li><a href="#projects" class="nav-link" data-section="projects">Projects</a></li>
                <li><a href="#github-activity" class="nav-link" data-section="github-activity">Activity</a></li>
                <li><a href="#experience" class="nav-link" data-section="experience">Experience</a></li>
                <li><a href="#certificates" class="nav-link" data-section="certificates">Certificates</a></li>
                <li><a href="/games" class="nav-link nav-link-games" title="Play Interactive Minigames"><i class="fas fa-gamepad"></i> Games</a></li>
            </ul>

            <!-- Right Actions: Theme Toggle + Get In Touch + 3D Animation Switcher -->
            <div class="nav-actions">
                <button type="button" class="theme-toggle-btn" id="theme-toggle" aria-label="Toggle Light and Dark Theme" title="Toggle Light / Dark Mode">
                    <i class="fas fa-sun icon-sun" aria-hidden="true"></i>
                    <i class="fas fa-moon icon-moon" aria-hidden="true"></i>
                </button>

                <a href="mailto:<%= data.info.email %>" class="btn-pill-cta" id="nav-cta-btn">
                    Get in Touch
                </a>

                <!-- 3D FX Switcher Dropdown (Positioned to the right of Get in Touch) -->
                <div class="fx-dropdown-wrapper">
                    <button type="button" class="fx-switcher-btn" id="fx-switcher-btn" aria-label="Switch 3D Animation Effect" title="Choose 3D Background Effect">
                        <i class="fas fa-shapes"></i>
                        <span class="fx-active-label" id="fx-active-label">3D: Torus Knot</span>
                        <i class="fas fa-chevron-down fx-chevron"></i>
                    </button>
                    <div class="fx-dropdown-menu" id="fx-dropdown-menu">
                        <button type="button" class="fx-dropdown-item active" data-fx="torus">
                            <span>🪐 3D Torus Knot</span>
                        </button>
                        <button type="button" class="fx-dropdown-item" data-fx="wave">
                            <span>🌊 3D Digital Wave</span>
                        </button>
                        <button type="button" class="fx-dropdown-item" data-fx="constellation">
                            <span>✨ Constellation Network</span>
                        </button>
                        <button type="button" class="fx-dropdown-item" data-fx="stardust">
                            <span>🌌 Ambient Stardust</span>
                        </button>
                    </div>
                </div>

                <!-- Mobile Hamburger Toggle -->
                <button type="button" class="nav-hamburger" id="nav-hamburger" aria-label="Toggle mobile menu" aria-expanded="false">
                    <span class="hamburger-bar"></span>
                    <span class="hamburger-bar"></span>
                    <span class="hamburger-bar"></span>
                </button>
            </div>
        </nav>
    </header>

    <!-- Mobile Drawer Overlay -->
    <div id="mobile-menu-overlay" class="mobile-menu-overlay"></div>
    <div id="mobile-menu-drawer" class="mobile-menu-drawer" role="dialog" aria-modal="true">
        <div class="mobile-menu-header">
            <span class="logo-initials">GW</span>
            <button type="button" class="mobile-menu-close" id="mobile-menu-close" aria-label="Close menu">&times;</button>
        </div>
        <ul class="mobile-menu-links">
            <li><a href="#home" class="mobile-link">Home</a></li>
            <li><a href="#skills" class="mobile-link">Skills</a></li>
            <li><a href="#projects" class="mobile-link">Projects</a></li>
            <li><a href="#github-activity" class="mobile-link">Activity</a></li>
            <li><a href="#experience" class="mobile-link">Experience</a></li>
            <li><a href="#certificates" class="mobile-link">Certificates</a></li>
            <li><a href="/games" class="mobile-link"><i class="fas fa-gamepad"></i> Minigames</a></li>
        </ul>
        <div class="mobile-menu-footer">
            <a href="mailto:<%= data.info.email %>" class="btn-pill-cta w-full text-center">Get in Touch</a>
        </div>
    </div>

    <!-- MAIN PAGE CONTENT (FULL-WIDTH SECTIONS) -->
    <main class="main-content">

        <!-- ====================================================================
             1. HERO SECTION (2-COLUMN SIGNATURE REFERENCE DESIGN)
             ==================================================================== -->
        <section id="home" class="section-hero">
            <div class="hero-container">
                <!-- Left Column: Typography & CTAs -->
                <div class="hero-text-col">
                    <p class="hero-greeting">Hello There 👋</p>
                    <h1 class="hero-name"><%= data.info.nama %></h1>
                    
                    <div class="hero-role-wrapper">
                        <span class="hero-role-prefix">I'm a</span>
                        <span class="hero-role-typing" id="typing-role"></span>
                        <span class="typing-cursor" aria-hidden="true"></span>
                    </div>

                    <p class="hero-bio">
                        <%= data.info.deskripsi %> I believe great design and solid code are the bridge between technology and people.
                    </p>

                    <div class="hero-actions-row">
                        <button type="button" class="btn-pill-cta btn-cv-preview-trigger" id="btn-preview-cv" onclick="openCvModal()">
                            <i class="fas fa-file-pdf"></i> Quick Preview CV
                        </button>
                        <a href="<%= data.info.cvUrl %>" download="<%= data.info.cvFilename %>" target="_blank" rel="noopener noreferrer" class="btn-pill-secondary">
                            <i class="fas fa-download"></i> Download
                        </a>

                        <div class="hero-socials">
                            <a href="<%= data.info.github %>" target="_blank" rel="noopener noreferrer" class="btn-social" aria-label="GitHub Profile" title="GitHub">
                                <i class="fab fa-github"></i>
                            </a>
                            <a href="<%= data.info.linkedin %>" target="_blank" rel="noopener noreferrer" class="btn-social" aria-label="LinkedIn Profile" title="LinkedIn">
                                <i class="fab fa-linkedin"></i>
                            </a>
                            <button type="button" class="btn-social" id="btn-copy-email" data-email="<%= data.info.email %>" aria-label="Copy Email" title="Copy Email Address">
                                <i class="fas fa-copy"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Signature Layered Tilted Card -->
                <div class="hero-image-col">
                    <div class="tilted-card-wrapper">
                        <!-- Tilted Teal/Emerald Backdrop Shape -->
                        <div class="tilted-backdrop-shape" aria-hidden="true"></div>

                        <!-- Foreground Squircle Photo Card -->
                        <div class="portrait-card">
                            <img 
                                src="<%= data.info.foto %>" 
                                alt="<%= data.info.nama %>" 
                                class="portrait-img"
                                onerror="this.src='https://api.dicebear.com/7.x/avataaars/svg?seed=Wirawan'"
                            >
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ====================================================================
             2. SKILLS SECTION (FULL-WIDTH)
             ==================================================================== -->
        <section id="skills" class="section-full">
            <div class="section-container">
                <div class="section-header">
                    <div class="section-badge-pill">
                        <i class="fas fa-code-branch"></i> Technical Stack
                    </div>
                    <h2 class="section-title">My Skills &amp; Stack</h2>
                    <p class="section-subtitle">Structured overview of modern technologies, libraries, and frameworks I use to engineer robust applications</p>
                </div>

                <% 
                    const frontendSkills = data.skills.filter(s => s.category === 'Frontend');
                    const backendSkills = data.skills.filter(s => s.category === 'Backend');
                    const toolsSkills = data.skills.filter(s => s.category === 'Mobile & Tools');

                    const skillCategories = [
                        {
                            id: 'frontend',
                            title: 'Frontend Development',
                            subtitle: 'Modern UI & Reactive Systems',
                            icon: 'fas fa-desktop',
                            desc: 'Crafting responsive, high-performance interfaces, component-driven layouts, and seamless state flows.',
                            badge: frontendSkills.length + ' Technologies',
                            skills: frontendSkills
                        },
                        {
                            id: 'backend',
                            title: 'Backend & Database',
                            subtitle: 'Scalable APIs & Data Integrity',
                            icon: 'fas fa-server',
                            desc: 'Engineering robust server architectures, secure RESTful APIs, authentication workflows, and relational databases.',
                            badge: backendSkills.length + ' Technologies',
                            skills: backendSkills
                        },
                        {
                            id: 'tools',
                            title: 'Mobile & Workflow Tools',
                            subtitle: 'Cross-Platform & Developer Experience',
                            icon: 'fas fa-toolbox',
                            desc: 'Building cross-platform mobile apps, interactive UI/UX prototypes, and optimized engineering environments.',
                            badge: toolsSkills.length + ' Technologies',
                            skills: toolsSkills
                        }
                    ];
                %>

                <!-- 3 Categorized Bento Cards -->
                <div class="skills-categories-grid">
                    <% skillCategories.forEach(cat => { %>
                        <div class="skill-category-card" id="skill-cat-<%= cat.id %>">
                            <div class="skill-category-header">
                                <div class="category-icon-box">
                                    <i class="<%= cat.icon %>"></i>
                                </div>
                                <div class="category-title-wrap">
                                    <h3 class="category-title"><%= cat.title %></h3>
                                    <span class="category-focus-tag"><%= cat.subtitle %></span>
                                </div>
                                <span class="category-count-badge"><%= cat.badge %></span>
                            </div>

                            <p class="category-desc"><%= cat.desc %></p>

                            <div class="category-divider"></div>

                            <div class="category-skills-tags">
                                <% cat.skills.forEach(skill => { %>
                                    <div class="skill-tag-item" title="<%= skill.nama %> (<%= skill.category %>)">
                                        <i class="<%= skill.icon %> skill-tag-icon" style="color: <%= skill.color %>;"></i>
                                        <span class="skill-tag-name"><%= skill.nama %></span>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </section>

        <!-- ====================================================================
             3. PROJECTS SECTION (FULL-WIDTH)
             ==================================================================== -->
        <section id="projects" class="section-full">
            <div class="section-container">
                <div class="section-header">
                    <div class="section-badge-pill">
                        <i class="fas fa-folder-open"></i> Portfolio Archive
                    </div>
                    <h2 class="section-title">Featured Projects</h2>
                    <p class="section-subtitle">Click the interactive project vault below to explore live applications, architectures, and demos</p>
                </div>

                <!-- Interactive Animated Project Folder Portal Card -->
                <div class="project-folder-portal-wrapper">
                    <a href="/projects" class="project-folder-card" id="project-folder-portal" aria-label="Open Project Gallery">
                        
                        <!-- Folder 3D Stage Area -->
                        <div class="folder-3d-stage">
                            <!-- Folder Back Flap / Tab -->
                            <div class="folder-back-panel">
                                <div class="folder-tab-handle">
                                    <i class="fas fa-folder"></i>
                                    <span>~/projects-vault/</span>
                                </div>
                                <span class="folder-status-indicator"><span class="pulse-dot"></span> <%= data.projects.length %> Projects</span>
                            </div>

                            <!-- Floating Project Preview Cards (Emerge and fan out from folder on hover) -->
                            <div class="folder-preview-stack">
                                <!-- Card 1: Genuine Solutions (Real screenshot) -->
                                <div class="stack-preview-item item-1">
                                    <div class="preview-thumb-wrap">
                                        <img src="/images/genuine-solutions-hero.png" alt="Genuine Solutions" class="stack-preview-img">
                                        <div class="preview-card-glass">
                                            <span class="preview-mini-title">Genuine Solutions</span>
                                            <span class="preview-mini-tag">Laravel &bull; React</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Card 2: Building Asset Management (3D / Analytics) -->
                                <div class="stack-preview-item item-2">
                                    <div class="preview-thumb-wrap preview-bg-3d">
                                        <div class="preview-graphic-mesh">
                                            <i class="fas fa-cube preview-center-icon"></i>
                                        </div>
                                        <div class="preview-card-glass">
                                            <span class="preview-mini-title">Asset Management 3D</span>
                                            <span class="preview-mini-tag">Three.js &bull; Analytics</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Card 3: Kenangan Senja (POS Coffee App) -->
                                <div class="stack-preview-item item-3">
                                    <div class="preview-thumb-wrap preview-bg-coffee">
                                        <div class="preview-graphic-mesh">
                                            <i class="fas fa-mug-hot preview-center-icon"></i>
                                        </div>
                                        <div class="preview-card-glass">
                                            <span class="preview-mini-title">Kenangan Senja</span>
                                            <span class="preview-mini-tag">PHP &bull; Blade &bull; MySQL</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Card 4: Log Gates (PKL Internship Logbook) -->
                                <div class="stack-preview-item item-4">
                                    <div class="preview-thumb-wrap preview-bg-next">
                                        <div class="preview-graphic-mesh">
                                            <i class="fas fa-clipboard-check preview-center-icon"></i>
                                        </div>
                                        <div class="preview-card-glass">
                                            <span class="preview-mini-title">Log Gates App</span>
                                            <span class="preview-mini-tag">Next.js &bull; Vercel</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Card 5: Campus Info App (Mobile Flutter) -->
                                <div class="stack-preview-item item-5">
                                    <div class="preview-thumb-wrap preview-bg-mobile">
                                        <div class="preview-graphic-mesh">
                                            <i class="fas fa-mobile-screen preview-center-icon"></i>
                                        </div>
                                        <div class="preview-card-glass">
                                            <span class="preview-mini-title">Campus Mobile</span>
                                            <span class="preview-mini-tag">Flutter &bull; Dart</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Folder Front Pocket (Cards slide out from behind this) -->
                            <div class="folder-front-pocket">
                                <div class="folder-pocket-texture"></div>
                                <div class="folder-clasp">
                                    <div class="folder-clasp-badge">
                                        <i class="fas fa-sparkles"></i>
                                        <span>Hover to peek inside &bull; Click to open</span>
                                    </div>
                                </div>
                                <div class="folder-pocket-meta">
                                    <span class="folder-pocket-title">FULLSTACK_ARCHIVE</span>
                                    <span class="folder-pocket-count"><i class="fas fa-layer-group"></i> <%= data.projects.length %> Production Apps</span>
                                </div>
                            </div>
                        </div>

                        <!-- Card Content & Action Callout -->
                        <div class="folder-card-info">
                            <div class="folder-info-text">
                                <h3 class="folder-headline">Explore All Engineering Projects</h3>
                                <p class="folder-subtext">
                                    Hover over the folder above to peek inside, or click anywhere on this card to open the dedicated gallery with live demos, full architectures, and responsive device mockups.
                                </p>
                            </div>
                            <div class="folder-cta-action">
                                <span class="btn-pill-cta folder-cta-btn">
                                    Open Project Gallery <i class="fas fa-arrow-right"></i>
                                </span>
                            </div>
                        </div>

                    </a>
                </div>
            </div>
        </section>

        <!-- ====================================================================
             LIVE GITHUB ACTIVITY & METRICS SECTION (FULL-WIDTH)
             ==================================================================== -->
        <section id="github-activity" class="section-full">
            <div class="section-container">
                <div class="section-header">
                    <div class="section-badge-pill">
                        <i class="fab fa-github"></i> Real-time Open Source Footprint
                    </div>
                    <h2 class="section-title">GitHub Activity &amp; Live Stats</h2>
                    <p class="section-subtitle">Real-time repository statistics, top languages, and open source commits</p>
                </div>

                <div class="github-stats-container" id="github-stats-container">
                    <!-- Skeleton Loader State -->
                    <div class="github-skeleton-grid" id="github-skeleton">
                        <div class="github-card-skeleton stat-skeleton"></div>
                        <div class="github-card-skeleton stat-skeleton"></div>
                        <div class="github-card-skeleton stat-skeleton"></div>
                        <div class="github-card-skeleton stat-skeleton"></div>
                    </div>

                    <!-- Dynamic Render Container -->
                    <div id="github-live-content" style="display: none;">
                        <!-- Overview Metric Cards -->
                        <div class="github-metrics-grid">
                            <div class="github-metric-card">
                                <div class="metric-icon-wrap"><i class="fas fa-code-branch"></i></div>
                                <div class="metric-info">
                                    <span class="metric-value" id="gh-repos">-</span>
                                    <span class="metric-label">Public Repos</span>
                                </div>
                            </div>
                            <div class="github-metric-card">
                                <div class="metric-icon-wrap"><i class="fas fa-star"></i></div>
                                <div class="metric-info">
                                    <span class="metric-value" id="gh-stars">-</span>
                                    <span class="metric-label">Stars Earned</span>
                                </div>
                            </div>
                            <div class="github-metric-card">
                                <div class="metric-icon-wrap"><i class="fas fa-users"></i></div>
                                <div class="metric-info">
                                    <span class="metric-value" id="gh-followers">-</span>
                                    <span class="metric-label">Followers</span>
                                </div>
                            </div>
                            <div class="github-metric-card">
                                <div class="metric-icon-wrap"><i class="fas fa-calendar-alt"></i></div>
                                <div class="metric-info">
                                    <span class="metric-value" id="gh-member-year">-</span>
                                    <span class="metric-label">Active Since</span>
                                </div>
                            </div>
                        </div>

                        <!-- Top Languages & Live Profile Showcase -->
                        <div class="github-showcase-grid">
                            <!-- Languages Breakdown Card -->
                            <div class="github-panel-card languages-panel">
                                <div class="panel-card-header">
                                    <h4 class="panel-card-title"><i class="fas fa-code"></i> Top Code Languages</h4>
                                    <span class="panel-badge" id="gh-cache-badge">Live API</span>
                                </div>
                                <div class="languages-progress-stacked" id="gh-lang-progress"></div>
                                <div class="languages-legend-grid" id="gh-lang-legend"></div>
                            </div>

                            <!-- Live Profile & Quick CTA Card -->
                            <div class="github-panel-card github-profile-highlight">
                                <div class="gh-profile-header">
                                    <img id="gh-avatar" src="https://avatars.githubusercontent.com/u/36322459?v=4" alt="GitHub Avatar" class="gh-avatar-img">
                                    <div class="gh-profile-meta">
                                        <h4 class="gh-name" id="gh-name">I Gede Wirawan</h4>
                                        <a href="https://github.com/wiraputra" target="_blank" rel="noopener noreferrer" class="gh-handle" id="gh-handle">
                                            @wiraputra <i class="fas fa-external-link-alt"></i>
                                        </a>
                                    </div>
                                </div>
                                <p class="gh-bio" id="gh-bio">Software Engineer &amp; Cyber Security Enthusiast</p>
                                <div class="gh-cta-actions">
                                    <a href="https://github.com/wiraputra?tab=repositories" target="_blank" rel="noopener noreferrer" class="btn-pill-cta gh-visit-btn">
                                        <i class="fab fa-github"></i> Explore All Repositories
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ====================================================================
             4. EXPERIENCE & EDUCATION SECTION (FULL-WIDTH)
             ==================================================================== -->
        <section id="experience" class="section-full">
            <div class="section-container">
                <div class="section-header">
                    <h2 class="section-title">Experience &amp; Education</h2>
                    <p class="section-subtitle">My professional career and academic milestones</p>
                </div>

                <div class="experience-two-col-grid">
                    <!-- Work Experience -->
                    <div class="timeline-column">
                        <h3 class="timeline-column-heading">
                            <i class="fas fa-briefcase"></i> Work Experience
                        </h3>
                        <div class="timeline-flow">
                            <% data.resume.experience.forEach(exp => { %>
                                <div class="timeline-flow-item">
                                    <div class="timeline-flow-marker"></div>
                                    <div class="timeline-flow-card">
                                        <div class="timeline-flow-header">
                                            <h4 class="timeline-flow-title"><%= exp.title %></h4>
                                            <span class="timeline-date-chip"><%= exp.date %></span>
                                        </div>
                                        <p class="timeline-flow-place">
                                            <i class="fas fa-building"></i> <%= exp.place %>
                                        </p>
                                        <p class="timeline-flow-desc"><%= exp.desc %></p>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </div>

                    <!-- Education -->
                    <div class="timeline-column">
                        <h3 class="timeline-column-heading">
                            <i class="fas fa-graduation-cap"></i> Education
                        </h3>
                        <div class="timeline-flow">
                            <% data.resume.education.forEach(edu => { %>
                                <div class="timeline-flow-item">
                                    <div class="timeline-flow-marker"></div>
                                    <div class="timeline-flow-card">
                                        <div class="timeline-flow-header">
                                            <h4 class="timeline-flow-title"><%= edu.title %></h4>
                                            <span class="timeline-date-chip"><%= edu.date %></span>
                                        </div>
                                        <p class="timeline-flow-place">
                                            <i class="fas fa-university"></i> <%= edu.place %>
                                        </p>
                                        <p class="timeline-flow-desc"><%= edu.desc %></p>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ====================================================================
             5. CERTIFICATIONS SECTION (FULL-WIDTH)
             ==================================================================== -->
        <section id="certificates" class="section-full">
            <div class="section-container">
                <div class="section-header">
                    <div class="section-badge-pill">
                        <i class="fas fa-award"></i> Verified Credentials
                    </div>
                    <h2 class="section-title">Certifications &amp; Credentials</h2>
                    <p class="section-subtitle">Verified professional qualifications, cybersecurity competencies, and technical masterclasses</p>
                </div>

                <!-- Category Filters for Certifications -->
                <div class="cert-filter-nav">
                    <button type="button" class="cert-filter-pill active" data-filter="all">All Credentials (<%= data.certificates.length %>)</button>
                    <button type="button" class="cert-filter-pill" data-filter="Cyber Security"><i class="fas fa-shield-alt"></i> Cyber Security</button>
                    <button type="button" class="cert-filter-pill" data-filter="Web & Fullstack"><i class="fas fa-laptop-code"></i> Web &amp; Fullstack</button>
                    <button type="button" class="cert-filter-pill" data-filter="AI & Cloud"><i class="fas fa-brain"></i> AI &amp; Cloud</button>
                </div>

                <div class="cert-showcase-grid" id="cert-grid">
                    <% data.certificates.forEach(cert => { %>
                        <article class="cert-showcase-card" data-category="<%= cert.category %>">
                            <!-- Certificate Media Frame -->
                            <div class="cert-card-media" onclick="openLightbox('<%= cert.img %>')" role="button" tabindex="0" title="Click to view full certificate">
                                <img src="<%= cert.img %>" alt="<%= cert.title %>" class="cert-card-img" loading="lazy" onerror="this.src='https://via.placeholder.com/600x400?text=Certificate'">
                                <div class="cert-media-overlay">
                                    <span class="media-zoom-pill"><i class="fas fa-search-plus"></i> View Certificate</span>
                                </div>
                                <div class="cert-category-badge">
                                    <i class="<%= cert.categoryIcon || 'fas fa-award' %>"></i> <%= cert.category %>
                                </div>
                            </div>

                            <!-- Certificate Body -->
                            <div class="cert-showcase-content">
                                <div class="cert-issuer-row">
                                    <span class="cert-issuer-badge">
                                        <i class="fas fa-check-circle"></i> <%= cert.issuer %>
                                    </span>
                                </div>

                                <h3 class="cert-showcase-title"><%= cert.title %></h3>

                                <p class="cert-showcase-desc"><%= cert.desc %></p>

                                <div class="cert-showcase-tags">
                                    <% (cert.tags || []).forEach(tag => { %>
                                        <span class="tag-chip"><%= tag %></span>
                                    <% }); %>
                                </div>

                                <div class="cert-showcase-actions">
                                    <button type="button" class="btn-cert-action btn-preview-cert" onclick="openLightbox('<%= cert.img %>')" title="Quick Preview">
                                        <i class="fas fa-eye"></i> Preview
                                    </button>
                                    <% if (cert.link && cert.link !== '#') { %>
                                        <a href="<%= cert.link %>" target="_blank" rel="noopener noreferrer" class="btn-cert-action btn-verify-cert" title="Verify Online Credential">
                                            <span>Verify</span> <i class="fas fa-external-link-alt"></i>
                                        </a>
                                    <% } else { %>
                                        <span class="cert-offline-badge" title="Official Institutional Certificate">
                                            <i class="fas fa-certificate"></i> Verified Issued
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        </article>
                    <% }); %>
                </div>
            </div>
        </section>

    </main>

    <!-- ====================================================================
         FOOTER (FULL-WIDTH)
         ==================================================================== -->
    <footer class="footer-full">
        <div class="footer-container">
            <div class="footer-left">
                <span class="footer-logo">GW.</span>
                <p class="footer-copy">&copy; <%= new Date().getFullYear() %> <%= data.info.nama %>. All rights reserved.</p>
            </div>
            <div class="footer-links">
                <a href="<%= data.info.github %>" target="_blank" rel="noopener noreferrer" class="footer-nav-link">GitHub</a>
                <a href="<%= data.info.linkedin %>" target="_blank" rel="noopener noreferrer" class="footer-nav-link">LinkedIn</a>
                <a href="mailto:<%= data.info.email %>" class="footer-nav-link">Email</a>
                <a href="#home" class="footer-nav-link" id="btn-back-to-top">Back to Top &uarr;</a>
            </div>
        </div>
    </footer>

    <!-- ====================================================================
         MODALS (PROJECT DETAIL & LIGHTBOX)
         ==================================================================== -->
    <div id="project-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-hidden="true">
        <div class="modal-dialog modal-dialog-mockup">
            <button type="button" class="modal-close-button" onclick="closeProjectModal()" aria-label="Close dialog">&times;</button>
            
            <!-- Device Frame Mockup Switcher Toolbar -->
            <div class="mockup-switch-toolbar">
                <span class="mockup-switch-label"><i class="fas fa-layer-group"></i> Preview Mode:</span>
                <div class="mockup-switch-tabs">
                    <button type="button" class="mockup-tab-btn active" id="mockup-tab-desktop" onclick="switchMockupDevice('desktop')">
                        <i class="fas fa-laptop"></i> Desktop Frame
                    </button>
                    <button type="button" class="mockup-tab-btn" id="mockup-tab-mobile" onclick="switchMockupDevice('mobile')">
                        <i class="fas fa-mobile-alt"></i> Mobile Frame
                    </button>
                </div>
            </div>

            <!-- Device Mockup Viewport Chrome -->
            <div id="mockup-viewport" class="mockup-viewport-frame desktop-frame">
                <!-- Desktop Window Chrome Header -->
                <div class="mockup-window-header" id="mockup-desktop-header">
                    <div class="mockup-window-controls">
                        <span class="window-dot dot-red"></span>
                        <span class="window-dot dot-yellow"></span>
                        <span class="window-dot dot-green"></span>
                    </div>
                    <div class="mockup-address-bar">
                        <i class="fas fa-lock"></i>
                        <span id="mockup-address-url">https://project.local</span>
                    </div>
                    <div class="mockup-window-actions">
                        <i class="fas fa-external-link-alt"></i>
                    </div>
                </div>

                <!-- Mobile Smartphone Notch Header -->
                <div class="mockup-mobile-header" id="mockup-mobile-header" style="display: none;">
                    <span class="mobile-clock">09:41</span>
                    <div class="mobile-notch-sensor"></div>
                    <div class="mobile-status-icons">
                        <i class="fas fa-signal"></i>
                        <i class="fas fa-wifi"></i>
                        <i class="fas fa-battery-full"></i>
                    </div>
                </div>

                <!-- Mockup Screen Body -->
                <div class="mockup-screen-content">
                    <img id="modal-project-img" class="modal-image-preview" src="" alt="Project Preview" style="display: none;">
                </div>
            </div>

            <div class="modal-body">
                <div class="modal-header-meta">
                    <h3 id="modal-project-title" class="modal-title"></h3>
                    <div class="modal-external-actions" id="modal-project-links"></div>
                </div>
                <p id="modal-project-desc" class="modal-text"></p>
                <div id="modal-project-tags" class="project-showcase-tags"></div>
            </div>
        </div>
    </div>

    <div id="lightbox-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-hidden="true" onclick="closeLightbox()">
        <div class="lightbox-dialog" onclick="event.stopPropagation()">
            <button type="button" class="modal-close-button" onclick="closeLightbox()" aria-label="Close image">&times;</button>
            <img id="lightbox-img" class="lightbox-img" src="" alt="Certificate Preview">
        </div>
    </div>

    <!-- ====================================================================
         IN-APP QUICK VIEW PDF CV MODAL
         ==================================================================== -->
    <div id="cv-modal" class="modal-overlay cv-modal-overlay" role="dialog" aria-modal="true" aria-hidden="true" onclick="closeCvModal()">
        <div class="cv-modal-dialog" onclick="event.stopPropagation()">
            <div class="cv-modal-header">
                <div class="cv-modal-title-group">
                    <div class="cv-badge-icon"><i class="fas fa-file-pdf"></i></div>
                    <div>
                        <h3 class="cv-modal-title">Curriculum Vitae</h3>
                        <p class="cv-modal-subtitle"><%= data.info.nama %> &bull; In-App PDF Preview</p>
                    </div>
                </div>
                <div class="cv-modal-actions">
                    <a href="<%= data.info.cvUrl %>" target="_blank" rel="noopener noreferrer" class="btn-cv-header-action" title="Open in new tab">
                        <i class="fas fa-external-link-alt"></i> <span class="action-label">Open Tab</span>
                    </a>
                    <a href="<%= data.info.cvUrl %>" download="<%= data.info.cvFilename %>" class="btn-cv-header-action btn-cv-download-accent" title="Download CV">
                        <i class="fas fa-download"></i> <span class="action-label">Download</span>
                    </a>
                    <button type="button" class="modal-close-button cv-modal-close" onclick="closeCvModal()" aria-label="Close CV modal">&times;</button>
                </div>
            </div>
            <div class="cv-modal-body">
                <iframe id="cv-iframe" class="cv-iframe-element" src="" title="CV PDF Document"></iframe>
                <div id="cv-fallback-msg" class="cv-fallback-container" style="display: none;">
                    <i class="fas fa-file-pdf fallback-icon"></i>
                    <p>Browser Anda tidak mendukung preview PDF langsung di dalam frame.</p>
                    <a href="<%= data.info.cvUrl %>" download="<%= data.info.cvFilename %>" class="btn-pill-cta">
                        <i class="fas fa-download"></i> Download Berkas CV (PDF)
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div class="toast-container" aria-live="polite">
        <div id="app-toast" class="toast">
            <i class="fas fa-check-circle"></i>
            <span id="toast-message">Copied to clipboard!</span>
        </div>
    </div>

    <!-- Data Injection for Client Script -->
    <script id="portfolio-client-data" type="application/json">
        <%- JSON.stringify({ roles: data.info.role, email: data.info.email }) %>
    </script>

    <!-- Three.js 3D Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <!-- Client Script -->
    <script src="/script.js?v=50"></script>
</body>
</html>