<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- SEO Utama -->
    <title><%= data.info.nama %> | Fullstack Developer Portfolio</title>
    <meta name="description" content="<%= data.info.deskripsi %>">
    <meta name="keywords" content="Portfolio, Backend Developer, Express.js, Web Developer, Modern Portfolio">
    <meta name="author" content="<%= data.info.nama %>">

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://nama-project-kamu.vercel.app/">
    <meta property="og:title" content="Portofolio <%= data.info.nama %>">
    <meta property="og:description" content="<%= data.info.deskripsi %>">
    <meta property="og:image" content="/images/hero-bg.png">
    
    <!-- Mencegah Browser membalik warna jika menggunakan Force Dark Mode -->
    <meta name="color-scheme" content="dark">
    
    <!-- Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/style.css?v=5">
    <link rel="icon" href="/favicon.png" type="image/png">
</head>
<body>
    
    <!-- AMBIENT BACKGROUND -->
    <div class="ambient-bg">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
    </div>

    <!-- NAVIGATION -->
    <nav id="main-nav">
        <div class="nav-container">
            <div class="logo">WIRAWAN.</div>
            <div class="nav-links">
                <a href="#home">Home</a>
                <a href="#resume">Resume</a>
                <a href="#projects">Projects</a>
                <a href="#certifications">Certificates</a>
            </div>
        </div>
    </nav>

    <div class="bento-container" style="padding-top: 100px;">
        
        <!-- BENTO HERO & SKILLS -->
        <section id="home" class="bento-grid hero-bento">
            
            <!-- Box 1: Intro (Large) -->
            <div class="bento-item bento-col-span-2 bento-row-span-2 intro-box gsap-bento">
                <div class="status-badge">
                    <div class="pulse-dot"></div> Available for Projects
                </div>
                <h1>Hi, I'm <span class="gradient-text"><%= data.info.nama %></span></h1>
                <h2 id="typing-text"></h2>
                <p class="desc"><%= data.info.deskripsi %></p>
                <div class="hero-btns">
                    <a href="mailto:wirawanw62@gmail.com" class="btn btn-glow">
                        <i class="fas fa-paper-plane"></i> Contact Me
                    </a>
                    <a href="/cv.pdf" download="CV_I_Gede_Wirawan.pdf" target="_blank" class="btn btn-outline" rel="noopener noreferrer">
                        <i class="fas fa-file-download"></i> Download CV
                    </a>
                </div>
            </div>

            <!-- Box 2: Photo (Square) -->
            <div class="bento-item photo-box gsap-bento flex-center">
                <img src="<%= data.info.foto %>" alt="Foto Profil" class="profile-img" onerror="this.src='https://api.dicebear.com/7.x/avataaars/svg?seed=Felix'">
            </div>

            <!-- Box 3: Roles/Mini Info -->
            <div class="bento-item mini-info-box gsap-bento flex-center">
                <h3>Fullstack Developer</h3>
                <p>Passionate about crafting scalable backend and modern interfaces.</p>
            </div>

            <!-- Box 4: Tech Stack (Wide) -->
            <div class="bento-item bento-col-span-3 skills-box gsap-bento" id="skills">
                <h3>Tech Stack</h3>
                <div class="skills-mini-grid">
                    <% data.skills.forEach(skill => { %>
                        <div class="skill-pill">
                            <i class="<%= skill.icon %>" <% if (skill.color) { %>style="color: <%= skill.color %>"<% } %>></i> 
                            <span><%= skill.nama %></span>
                        </div>
                    <% }); %>
                </div>
            </div>
            
        </section>

        <!-- RESUME SECTION -->
        <section id="resume">
            <div class="section-header gsap-bento">
                <h2>Resume</h2>
            </div>
            <div class="bento-grid resume-bento">
                <!-- Exp -->
                <div class="bento-item bento-col-span-1 gsap-bento">
                    <h3 class="bento-title"><i class="fas fa-briefcase"></i> Experience</h3>
                    <div class="timeline">
                        <% data.resume.experience.forEach(item => { %>
                            <div class="timeline-item">
                                <span class="timeline-date"><%= item.date %></span>
                                <h4><%= item.title %></h4>
                                <span class="timeline-place"><%= item.place %></span>
                                <p><%= item.desc %></p>
                            </div>
                        <% }); %>
                    </div>
                </div>
                <!-- Edu -->
                <div class="bento-item bento-col-span-1 gsap-bento">
                    <h3 class="bento-title"><i class="fas fa-graduation-cap"></i> Education</h3>
                    <div class="timeline">
                        <% data.resume.education.forEach(item => { %>
                            <div class="timeline-item">
                                <span class="timeline-date"><%= item.date %></span>
                                <h4><%= item.title %></h4>
                                <span class="timeline-place"><%= item.place %></span>
                                <p><%= item.desc %></p>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </section>

        <!-- PROJECTS SECTION -->
        <section id="projects">
            <div class="section-header gsap-bento">
                <h2>Featured Projects</h2>
            </div>
            <div class="bento-grid projects-bento">
                <% data.projects.forEach((project, index) => { %>
                    <div class="bento-item project-card gsap-bento <%= index === 0 ? 'bento-col-span-2' : '' %>">
                        <% if (project.logo) { %>
                            <%- project.logo %>
                        <% } else { %>
                            <h3><%= project.judul %></h3>
                        <% } %>
                        <p><%= project.deskripsi %></p>
                        <div class="tags">
                            <% project.tags.forEach(tag => { %>
                                <span class="tag"><%= tag %></span>
                            <% }); %>
                        </div>
                        <% if (project.detailDesc) { %>
                            <a href="#" class="project-link" 
                               data-judul="<%= project.judul %>" 
                               data-desc="<%= project.detailDesc %>" 
                               data-img="<%= project.detailImg %>" 
                               data-tags='<%= JSON.stringify(project.tags) %>' 
                               onclick="openProjectModal(this); return false;">
                                View Detail <i class="fas fa-arrow-right"></i>
                            </a>
                        <% } else { %>
                            <a href="<%= project.link %>" class="project-link" target="_blank" rel="noopener noreferrer">
                                View Detail <i class="fas fa-arrow-right"></i>
                            </a>
                        <% } %>
                    </div>
                <% }); %>
            </div>
        </section>

        <!-- CERTIFICATIONS SECTION -->
        <section id="certifications">
            <div class="section-header gsap-bento">
                <h2>Certifications</h2>
            </div>
            
            <div class="bento-grid cert-bento">
                <% data.certificates.forEach(cert => { %>
                    <div class="bento-item cert-card gsap-bento">
                        <div class="cert-img-container" data-img="<%= cert.img %>" onclick="openModal(this.getAttribute('data-img'))">
                            <img src="<%= cert.img %>" alt="<%= cert.title %>" onerror="this.src='https://via.placeholder.com/400x250?text=No+Image'">
                        </div>
                        <div class="cert-info">
                            <h3><%= cert.title %></h3>
                            <span class="cert-issuer"><%= cert.issuer %></span>
                            <div class="cert-actions">
                                <button class="btn-icon" data-img="<%= cert.img %>" onclick="openModal(this.getAttribute('data-img'))">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <% if (cert.link) { %>
                                    <a href="<%= cert.link %>" target="_blank" rel="noopener noreferrer" class="btn-icon">
                                        <i class="fas fa-external-link-alt"></i>
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </section>

        <footer>
            <div class="bento-item footer-content gsap-bento" style="margin-top: 50px; text-align: center;">
                <p>Designed with Bento Box Grid.</p>
                <p>&copy; 2026 I Gede Wirawan. All rights reserved.</p>
                <div class="social-links" style="margin-top: 15px; display: flex; gap: 20px; justify-content: center;">
                    <a href="https://github.com/wiraputra" style="color: var(--text-muted); font-size: 1.5rem;"><i class="fab fa-github"></i></a>
                    <a href="https://www.linkedin.com/in/i-gede-wirawan-849651172/" style="color: var(--text-muted); font-size: 1.5rem;"><i class="fab fa-linkedin"></i></a>
                </div>
            </div>
        </footer>
    </div>

    <!-- Script Data via Dataset untuk mencegah IDE/Linter bugs -->
    <div id="portfolio-data" data-roles="<%= JSON.stringify(data.info.role) %>" style="display: none;"></div>
    
    <!-- MODAL -->
    <div id="certModal" class="modal" onclick="closeModal()" style="display:none; position:fixed; z-index:2000; top:0; left:0; width:100%; height:100%; align-items:center; justify-content:center;">
        <span style="position:fixed; top:20px; right:40px; font-size:40px; cursor:pointer; color: white;">&times;</span>
        <img id="modalImage" class="modal-content" style="max-width:90%; max-height:90%; border-radius: 20px;">
    </div>

    <!-- PROJECT DETAIL MODAL -->
    <div id="projectModal" class="modal" onclick="closeProjectModal()">
        <div class="modal-card" onclick="event.stopPropagation()">
            <span class="modal-close-btn" onclick="closeProjectModal()">&times;</span>
            <div class="modal-img-container">
                <img id="projectModalImg" src="" alt="Project Preview">
            </div>
            <div class="modal-body">
                <h3 id="projectModalTitle"></h3>
                <p id="projectModalDesc"></p>
                <div id="projectModalTags" class="tags"></div>
            </div>
        </div>
    </div>

    <!-- GSAP & ScrollTrigger -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

    <!-- Script JS -->
    <script src="/script.js?v=5"></script>
</body>
</html>